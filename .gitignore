# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OpenNext
.open-next

# Wrangler
.wrangler

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# note: lib/git-log.generated.json is committed on purpose. `predev`/`prebuild`
# rewrite it from git history, so it can show as modified after new commits.

# local tooling artifacts
.opencode/
graphify-out/
